{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "removeComments": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {"@src/*": ["./src/*"]}
  }
}
